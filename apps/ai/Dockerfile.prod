# Multi-stage production build for FastAPI AI service
# Optimized for size, security, and GPU support (optional)

# =============================================================================
# Base image - Python 3.12 slim with security updates
# =============================================================================
FROM python:3.14-slim AS base

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    curl \
    dumb-init \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user
RUN groupadd --gid 1001 appgroup && \
    useradd --uid 1001 --gid 1001 --shell /bin/bash --create-home appuser

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# =============================================================================
# Dependencies stage - install Python packages
# =============================================================================
FROM base AS deps

# Copy requirements first for better caching
COPY requirements.txt .

# Install dependencies to user site-packages
RUN pip install --user --no-cache-dir -r requirements.txt

# =============================================================================
# Builder stage - copy app and compile Python bytecode
# =============================================================================
FROM base AS builder

COPY --from=deps /root/.local /home/appuser/.local
COPY app ./app

# Compile Python files for faster startup
RUN python -m compileall /home/appuser/.local /app

# =============================================================================
# Runner stage - minimal production image
# =============================================================================
FROM base AS runner

# Copy installed packages
COPY --from=builder /home/appuser/.local /home/appuser/.local
COPY --from=builder /app ./app

# Set PATH to include user packages
ENV PATH=/home/appuser/.local/bin:$PATH

# Change ownership
RUN chown -R appuser:appgroup /app

USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health/live || exit 1

EXPOSE 8000

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]